# ==============================================================================
# TenderBee Environment Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# A. RENDER WEB SERVICE (BACKEND) ENVIRONMENT VARIABLES
# ------------------------------------------------------------------------------
# 1. Django Core & Security
DJANGO_SECRET_KEY=generate-a-strong-random-50-character-secret-key-here
DJANGO_DEBUG=False
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://your-frontend-app.vercel.app,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://your-frontend-app.vercel.app,https://*.vercel.app
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# 2. Database Connection (Neon Serverless PostgreSQL or Render PostgreSQL)
# For Neon: DATABASE_URL is pooled connection, DIRECT_URL is direct session connection
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/tenderbee?sslmode=require
DIRECT_URL=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/tenderbee?sslmode=require
# Set to 'false' only if using Render Internal Database private network
DB_SSL_REQUIRE=true

# 3. Redis & Celery (Optional / if worker is enabled)
REDIS_URL=redis://localhost:6379/0

# 4. JWT Token Lifetimes
JWT_ACCESS_MINUTES=10
JWT_REFRESH_DAYS=7

# 5. Object Storage (Options: b2, disk, r2, catalyst)
STORAGE_BACKEND=b2
B2_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
B2_APPLICATION_KEY_ID=your_backblaze_keyID
B2_APPLICATION_KEY=your_backblaze_applicationKey
B2_BUCKET_NAME=your_b2_bucket_name
B2_REGION=us-west-004

# 6. External APIs
TINYFISH_API_KEY=your_tinyfish_api_key_here
LLM_API_KEY=your_llm_api_key_here


# ------------------------------------------------------------------------------
# B. VERCEL PROJECT (FRONTEND) ENVIRONMENT VARIABLES
# ------------------------------------------------------------------------------
# Set this to the live URL of your Render backend service (without trailing slash)
BACKEND_URL=https://tenderbee-backend.onrender.com
INTERNAL_BACKEND_URL=https://tenderbee-backend.onrender.com
NODE_ENV=production
